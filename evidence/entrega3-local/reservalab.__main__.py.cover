     1 """Ponto de entrada: python -m reservalab."""
     2 
+    3 import argparse
     4 
+    5 from . import __version__
+    6 from .server import create_server
     7 
     8 
+    9 def main():
+   10     parser = argparse.ArgumentParser(description="API local de reservas de salas de estudo")
+   11     parser.add_argument("--version", action="version", version=f"ReservaLab {__version__}")
+   12     parser.add_argument("--host", default="127.0.0.1", help="Interface de rede (padrão: 127.0.0.1)")
+   13     parser.add_argument("--port", type=int, default=8000, help="Porta HTTP (padrão: 8000)")
+   14     parser.add_argument("--db", default="data/reservalab.db", help="Arquivo SQLite (padrão: data/reservalab.db)")
+   15     args = parser.parse_args()
+   16     server = create_server(args.db, host=args.host, port=args.port)
+   17     print(f"ReservaLab em http://{args.host}:{server.server_port} | banco: {args.db}", flush=True)
+   18     try:
+   19         server.serve_forever()
+   20     except KeyboardInterrupt:
+   21         print("\nEncerrando ReservaLab.", flush=True)
    22     finally:
+   23         server.server_close()
    24 
    25 
+   26 if __name__ == "__main__":
+   27     main()
